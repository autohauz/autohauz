# ─────────────────────────────────────────────────────────────────────────────
# AutoHauz — environment variables
# Copy to .env.local and fill in. Never commit real secrets (.env* is gitignored).
# The contract (names, types, required/optional) lives in src/lib/env.ts —
# a variable that is not declared there is not read by the application.
# ─────────────────────────────────────────────────────────────────────────────

# ── NEXT_PUBLIC_ (exposed to the browser — never put a secret here) ──────────
NEXT_PUBLIC_APP_URL=https://autohauz.com.au
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Analytics / Search Console verification (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Social profile links (optional; rendered only when set — no fallbacks)
NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=
NEXT_PUBLIC_SOCIAL_LINKEDIN_URL=
NEXT_PUBLIC_SOCIAL_X_URL=

# ── SUPABASE_ (server only) ──────────────────────────────────────────────────
# Service-role key bypasses RLS. Only used after authorization has been checked.
SUPABASE_SERVICE_ROLE_KEY=
# Bearer token expected by the Supabase edge functions (search-index-worker, lead-cleanup).
WORKER_API_KEY=

# ── APP_ / admin bootstrap ───────────────────────────────────────────────────
# Comma-separated allowlist is a bootstrap fallback; admin_roles is the primary authority.
ADMIN_EMAIL=
ADMIN_EMAIL_ALLOWLIST=
# Bearer token for /api/cron/* routes. Fail-closed: unset = every cron call is refused.
CRON_SECRET=
# Set to 1 to skip env validation (CI lint/test only — never in a deployed environment).
SKIP_ENV_VALIDATION=

# ── Geo restriction (edge proxy; see src/lib/security/geo-restriction.ts) ────
# Site is served only to the listed countries. Defaults to AU + IN when unset.
GEO_RESTRICTION_ENABLED=
GEO_ALLOWED_COUNTRIES=
# Only "true" when self-hosting behind a geo-aware proxy that injects and
# strips x-vercel-ip-country / cf-ipcountry / x-geo-country. Auto-detected on Vercel.
GEO_TRUST_PROXY_HEADERS=
# Non-production only: simulate a visitor country, e.g. GEO_DEV_COUNTRY=US
GEO_DEV_COUNTRY=

# ── TURNSTILE_ (Cloudflare anti-spam on every public form) ───────────────────
TURNSTILE_SECRET_KEY=
# "true" in non-prod to skip verification during local development.
TURNSTILE_SKIP=

# ── UPSTASH_ / Redis (rate limiting) ─────────────────────────────────────────
# Any Redis URL (Upstash-compatible). Falls back to in-memory — NOT safe on serverless.
REDIS_URL=
# Salt for hashing lead IP addresses (raw IPs are never stored). Required in production.
IP_HASH_SECRET=

# ── Transactional email: SMTP via nodemailer (AWS SES or any relay). No-ops if unset. ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
REPLY_TO_EMAIL=
# Fallback recipient for lead alerts when settings.notification_recipients is empty.
CONTACT_EMAIL_TO=
# Signs unsubscribe and subscription-confirmation links (32+ random chars).
# Unset: derived from SUPABASE_SERVICE_ROLE_KEY (rotating that key then
# invalidates links already sent — set a dedicated value in production).
EMAIL_TOKEN_SECRET=

# ── Syndication module (docs/syndication/) ───────────────────────────────────
# Master safety switch. Live pushes require this AND a non-development
# environment; the default (unset/false) is dry-run. Never true outside prod.
SYNDICATION_LIVE_PUSH=false
# Volume guard: abort publishing if the item count drops by more than this
# fraction vs the last successful run (a truncated feed deletes listings at the channel).
FEED_MAX_DROP_PCT=0.20
FEED_STORAGE_BUCKET=
# High-entropy secret used to derive per-dealer, per-channel feed URL tokens.
FEED_SIGNING_SECRET=
# Google Vehicle Ads feed batch size (default 5).
GOOGLE_FEED_LIMIT=
# Meta Marketplace webhook + lead ingestion
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=

# ── BUSINESS_ / INVOICE_ ─────────────────────────────────────────────────────
# Business identity (legal name, ABN, address, phone, hours, GST, invoice
# numbering) is NOT configured here: it is edited by staff in Admin → Settings
# and stored in the `settings` table, with blank defaults in src/config/.
